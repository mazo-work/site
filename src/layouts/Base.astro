---
// Every page's document. Head order matters: the theme boot runs before the stylesheet so the first paint is
// already in the right mask. `bare` drops the skeleton (the entrance). v4: one skeleton on every page in every mask
// (BRIEF.md §3): the header (utility row, masthead, menu band), the page, the footer, and the Ask button. Two masks,
// Paper and Night; Profile is parked (src/styles/themes/profile.css is kept and never loaded).
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/skeleton.css';
import '../styles/pages.css';
import '../styles/ring.css';
import '../styles/themes/paper.css';
import '../styles/themes/night.css';
import '../styles/switcher.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
import Beacon from '../components/Beacon.astro';
import { BOOT } from '../data/theme-boot.mjs';
import { SITE_NAME } from '../data/site';
import { jsonldFor, type Schema } from '../data/jsonld';
import puzzle from '../../docs/puzzle/mazo-burr.json';

interface Props {
  title: string;              // the page's own name; the document title adds the site's
  description: string;
  noindex?: boolean;
  bare?: boolean;
  bodyClass?: string;
  canonical?: boolean;        // false for pages that are not documents (the 404)
  schema?: Schema;            // JSON-LD: which kind of page this is (default: a WebPage)
}
const { title, description, noindex = false, bare = false, bodyClass, canonical: hasCanonical = true, schema } = Astro.props;
const path = Astro.url.pathname;
const docTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
const canonical = new URL(path, Astro.site).href;
const twin = path === '/' ? '/index.md' : path.replace(/\/$/, '') + '.md';
const graph = hasCanonical ? jsonldFor(path, title, description, schema) : null;
// For whoever reads the source (U11): the mark as text, drawn from the puzzle's glyphs, the O solved, and Jon's note.
const glyphs = (['M', 'A', 'Z', 'O'] as const).map((L) => (puzzle.designs[0].pieces as any)[L].glyph as string[]);
const art = [0, 1, 2, 3, 4].map((r) => glyphs.map((g, k) => [...g[r]].map((ch, c) =>
  ch === 'X' || (k === 3 && (r === 0 || r === 4 || c === 0 || c === 4)) ? '\u2588\u2588' : '  ').join('')).join('   ')).join('\n  ');
const sourceNote = `<!--\n\n  ${art}\n\n  [JON: a message for whoever reads the source]\n\n-->`;
---
<!doctype html>
<Fragment set:html={sourceNote} />
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={BOOT}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {hasCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    {hasCanonical && <link rel="alternate" type="text/markdown" href={twin} title="This page in Markdown" />}
    <link rel="alternate" type="application/rss+xml" href="/notes/rss.xml" title="Lab notes" />
    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />}
    <Beacon />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    {bare ? (
      <main id="main" tabindex="-1"><slot /></main>
    ) : (
      <div class="frame">
        <Masthead path={path} />
        <main id="main" tabindex="-1"><slot /></main>
        <Footer path={path} />
      </div>
    )}
    {!bare && <Chat />}
  </body>
</html>
