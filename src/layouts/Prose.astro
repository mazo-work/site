---
// Markdown pages in src/pages (About, and Now with Uses as its last section): the title as the page's display
// headline, the lede, then the Markdown. With `photo`, a side column carries the portrait (the mocks: 7 to 4 on a
// desktop; on a phone it follows the lede).
import Base from './Base.astro';
import Portrait from '../components/Portrait.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} schema={frontmatter.schema ? { type: frontmatter.schema } : undefined}>
  <div class:list={['page', 'reading', { 'has-side': frontmatter.photo }]}>
    <header class="page-head">
      <h1 class="display misreg" data-text={frontmatter.title}>{frontmatter.title}</h1>
      {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
    </header>
    {frontmatter.photo && <aside class="side" aria-label="The portrait"><Portrait /></aside>}
    <div class="prose body">
      <slot />
    </div>
  </div>
</Base>
