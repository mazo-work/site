---
// Markdown pages in src/pages (About, Now, with Uses as a section of Now since v4): the title as <h1>, then the Markdown.
import Base from './Base.astro';
import Portrait from '../components/Portrait.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} schema={frontmatter.schema ? { type: frontmatter.schema } : undefined}>
  <article class="prose">
    <header class:list={['page-head', { 'has-photo': frontmatter.photo }]}>
      <div class="page-title">
        <h1>{frontmatter.title}</h1>
        {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
      </div>
      {frontmatter.photo && <Portrait />}
    </header>
    <slot />
  </article>
</Base>
