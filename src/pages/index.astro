---
// The entrance (U3: the still picture and the way in; U5 adds the puzzle, which loads after first paint).
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { SITE_NAME, DESCRIPTIONS } from '../data/site';
---
<Base title={SITE_NAME} description={DESCRIPTIONS.home} bare bodyClass="is-entrance">
  <div class="entrance">
    <Mark />
    <h1>{SITE_NAME}</h1>
    <nav aria-label="Ways in">
      <ul>
        <li><a href="/home/" id="skip-intro">Skip intro</a></li>
        <li><a href="/recruiters/">For recruiters</a></li>
      </ul>
    </nav>
  </div>
</Base>
