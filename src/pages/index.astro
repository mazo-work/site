---
// The entrance (U5). Without JavaScript: the mark as a still picture and the ways in (Skip intro, For recruiters).
// With it: the same picture on the dark stage while the puzzle loads after first paint (src/entrance/puzzle.js,
// three.js included, is imported only here), then P0's puzzle. Ids are P0's: the ported script uses them.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { SITE_NAME, DESCRIPTIONS } from '../data/site';
import '../styles/entrance.css';
---
<Base title={SITE_NAME} description={DESCRIPTIONS.home} bare bodyClass="is-entrance">
  <div class="entrance-still"><Mark /></div>
  <header id="top" class="entrance-top">
    <h1 id="tag">{SITE_NAME}</h1>
    <div class="topbtns">
      <button id="sound" class="js-only" type="button" aria-pressed="true">Sound on</button>
      <nav aria-label="Ways in">
        <ul>
          <li><a id="skip" href="/home/">Skip intro</a></li>
          <li><a href="/recruiters/">For recruiters</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <div class="puzzle-ui">
    <div id="stage" tabindex="0" role="application" aria-label="MAZO puzzle. Arrow keys turn it. Enter pulls the letter that is free." data-art><canvas id="snap" aria-hidden="true"></canvas></div>
    <p id="hint" class="ui">Drag to turn it. Pull a letter out.</p>
    <div id="bottom" class="ui">
      <button id="design" class="dev" type="button" title="Switch between the two shortlisted shapes">Shape: Pedestal</button>
      <button id="colors" class="dev" type="button" aria-pressed="true">Letter colors</button>
      <button id="showme" type="button" hidden>Show me</button>
      <span class="spacer"></span>
      <button id="dbg" class="dev" type="button" aria-pressed="false">Debug</button>
    </div>
    <svg id="arrow" viewBox="0 0 56 56" aria-hidden="true"><path d="M10 28h30" stroke="#ffcf8a" stroke-width="4" stroke-linecap="round" fill="none"/><path d="M32 18l12 10-12 10" stroke="#ffcf8a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    <div id="done" class="ui" hidden><button id="replay" type="button">Replay</button></div>
    <div id="debug" class="ui"></div>
    <div id="fallback" class="ui"><div class="card"><h2>3D isn't available here</h2><p>This browser can't draw the puzzle.</p><a id="fbskip" href="/home/">Go to the site</a></div></div>
    <div id="live" class="vh" aria-live="polite"></div>
  </div>
</Base>

<script>
  // After first paint, and only on this page: the puzzle and three.js, as their own chunks.
  requestAnimationFrame(() => requestAnimationFrame(() => { import('../entrance/puzzle.js'); }));
</script>
