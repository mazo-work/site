---
// Home (v4): the ring directly under the menu band (U6), then the headline and Jon's lines, and the latest project
// and the latest note beside them (the mocks).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Teaser from '../components/Teaser.astro';
import Ring from '../components/Ring.astro';
import { DESCRIPTIONS, HOME_HEADLINE } from '../data/site';
const project = (await getCollection('projects')).filter((p) => p.data.status !== 'coming-soon').sort((a, b) => a.data.order - b.data.order)[0];
const note = (await getCollection('notes')).sort((a, b) => +b.data.date - +a.data.date)[0];
---
<Base title="Home" description={DESCRIPTIONS.home} schema={{ type: 'home' }}>
  <Ring />
  <div class="page home">
    <header class="page-head home-head">
      <h1 class="display misreg" data-text={HOME_HEADLINE}>{HOME_HEADLINE}</h1>
      <p class="lede">[JON: one or two lines in your own voice, under your own headline]</p>
    </header>
    <Teaser href={`/projects/${project.id}/`} label="Latest project" title={project.data.title} desc={project.data.description} />
    {note && <Teaser href={`/notes/${note.id}/`} label="Latest note" title={note.data.title} desc={note.data.description} />}
  </div>
</Base>
