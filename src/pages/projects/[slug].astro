---
// A case study. A "coming-soon" shell has no content: noindex, no Article (BRIEF.md §3).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const shell = entry.data.status === 'coming-soon';
---
<Base title={entry.data.title} description={entry.data.description} noindex={shell}
  schema={shell ? { type: 'webpage' } : { type: 'article', datePublished: entry.data.date }}>
  <article class="prose">
    <header class="page-head">
      <p class="meta"><a href="/projects/">Projects</a></p>
      <h1>{entry.data.title}</h1>
      {shell ? <p class="lede">Coming soon.</p> : <p class="lede">{entry.data.description}</p>}
      {entry.data.voice && <p class="voice">{entry.data.voice}</p>}
    </header>
    <Content />
  </article>
</Base>
