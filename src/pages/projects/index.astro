---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Teaser from '../../components/Teaser.astro';
import { DESCRIPTIONS } from '../../data/site';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description={DESCRIPTIONS.projects}>
  <div class="page reading">
    <header class="page-head">
      <h1 class="display misreg" data-text="Projects">Projects</h1>
      <p class="lede">{DESCRIPTIONS.projects}</p>
    </header>
    <ul class="teasers body">
      {projects.map((p) => (
        <li><Teaser href={`/projects/${p.id}/`} title={p.data.title} desc={p.data.status === 'coming-soon' ? 'Coming soon.' : p.data.description} /></li>
      ))}
    </ul>
  </div>
</Base>
