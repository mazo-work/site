---
// The colophon. U3: the stack, from the build. U10 adds the headers, sizes, fonts, licences, analytics,
// crawler policy and accessibility statement.
import Base from '../layouts/Base.astro';
import { DESCRIPTIONS } from '../data/site';
import pkg from '../../package.json';
const astro = pkg.dependencies.astro;
---
<Base title="Colophon" description={DESCRIPTIONS.colophon}>
  <article class="prose">
    <header class="page-head">
      <h1>Colophon</h1>
      <p class="lede">{DESCRIPTIONS.colophon}</p>
    </header>
    <section aria-labelledby="stack">
      <h2 id="stack">Stack</h2>
      <p>Built with Astro {astro} as static files: every page is complete HTML and CSS, and reads without JavaScript. Scripts load only where a part needs one.</p>
    </section>
    <section aria-labelledby="made">
      <h2 id="made">How this was made</h2>
      <p>[JON: how this site was made, in your words: the brief, the puzzle, working with an AI.]</p>
    </section>
  </article>
</Base>
