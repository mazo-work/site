---
// The mask toggle (BRIEF.md §3, the skeleton): Paper or Night, nothing else (Profile is parked: hidden, not deleted).
// A native radio group, so arrow keys, labels and screen readers work as they do everywhere; its legend "Mask" is
// visible, as in the mocks. Shown only with JavaScript (without it there is nothing to remember a choice with). The
// checked radio follows <html data-theme>, set before first paint, so the control never flashes either.
import { THEMES } from '../data/theme-boot.mjs';
const NAMES: Record<string, string> = { paper: 'Paper', night: 'Night' };
---
<fieldset class="masks" data-theme-switch>
  <legend>Mask</legend>
  {THEMES.map((t) => (
    <label class="mask">
      <input type="radio" name="theme" value={t} />
      <span>{NAMES[t]}</span>
    </label>
  ))}
</fieldset>
<script>
  import '../scripts/theme-switch.js';
</script>
