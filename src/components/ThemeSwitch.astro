---
// The theme switcher as masks (BRIEF.md §3, an optional idea Jon approved): put one on and the site becomes someone
// else. A native radio group, so arrow keys, labels and screen readers work as they do everywhere. Shown only with
// JavaScript (without it there is nothing to remember a choice with). The selected look follows <html data-theme>,
// set before first paint, so the control never flashes either.
import { THEMES } from '../data/theme-boot.mjs';
const NAMES: Record<string, string> = { editorial: 'Editorial', terminal: 'Terminal', profile: 'Profile' };
const MASK = 'M2.2 3.1C6.3.2 17.7.2 21.8 3.1c2.1 1.9 1.4 7.7-2.5 8.8-3 .9-4.9-1.8-7.3-1.8s-4.3 2.7-7.3 1.8C.8 10.8.1 5 2.2 3.1zM5.4 6a2.6 1.8 0 1 0 5.2 0 2.6 1.8 0 1 0-5.2 0zm8 0a2.6 1.8 0 1 0 5.2 0 2.6 1.8 0 1 0-5.2 0z';
---
<fieldset class="masks" data-theme-switch>
  <legend class="vh">Theme</legend>
  {THEMES.map((t) => (
    <label class={`mask mask-${t}`}>
      <input type="radio" name="theme" value={t} />
      <svg viewBox="0 0 24 14" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={MASK} /></svg>
      <span>{NAMES[t]}</span>
    </label>
  ))}
</fieldset>
<script>
  import '../scripts/theme-switch.js';
</script>
