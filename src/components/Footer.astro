---
import { FOOTER_NAV, SITE_NAME } from '../data/site';
interface Props { path: string; }
const { path } = Astro.props;
---
<footer class="site-footer">
  <p class="footer-name">{SITE_NAME}</p>
  <svg class="regmark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor"/><path d="M12 0v24M0 12h24" stroke="currentColor"/></svg>
  <nav aria-label="Footer">
    <ul>
      {FOOTER_NAV.map((item) => (
        <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</footer>
