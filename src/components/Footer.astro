---
// The footer (BRIEF.md §3, the skeleton, item 5): "Jonathan Mazo · [JON: region]" on the left, Colophon on the right.
// The Colophon is reached from here only.
import { FOOTER_NAV, SITE_NAME } from '../data/site';
interface Props { path: string; }
const { path } = Astro.props;
---
<footer class="site-footer">
  <p class="footer-name">{SITE_NAME} · [JON: region]</p>
  <nav aria-label="Footer">
    <ul>
      {FOOTER_NAV.map((item) => (
        <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</footer>
