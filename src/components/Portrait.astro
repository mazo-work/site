---
// Jon's photo. The real image carries the alt text; a decorative copy (alt="", hidden from assistive tech) lets a
// mask draw the photo another way on top (Paper: a halftone screen that clears when you look closer; Night: an X-ray
// in a round window, with a ring and a scanning line, which Paper hides).
// Loaded eagerly: it sits at the top of About and For recruiters, where it is the largest thing painted (U15).
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.webp';
import { sidebar } from '../data/v2-words';
import Parakeet from './Parakeet.astro';
interface Props { width?: number; class?: string; }
const { width = 320, class: cls } = Astro.props;
---
<figure class:list={['portrait', cls]}>
  <span class="portrait-screen" aria-hidden="true"><Image src={headshot} alt="" width={width} loading="eager" /></span>
  <Image class="portrait-img" src={headshot} alt={sidebar.headshotAlt} width={width} loading="eager" fetchpriority="high" />
  <span class="portrait-scan" aria-hidden="true"></span>
  <svg class="portrait-ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="46" /><path d="M50 0v5M50 95v5M0 50h5M95 50h5" /></svg>
  <Parakeet place="portrait" />
</figure>
<script>
  import '../scripts/parakeet.js';
</script>
