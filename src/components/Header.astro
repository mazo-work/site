---
import Mark from './Mark.astro';
import { NAV, SITE_NAME } from '../data/site';
interface Props { path: string; }
const { path } = Astro.props;
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header">
  <a class="brand" href="/home/" aria-current={path === '/home/' ? 'page' : undefined}>
    <Mark />
    <span class="brand-name">{SITE_NAME}</span>
  </a>
  <span class="crumb" aria-hidden="true">~{path}</span>
  <nav class="site-nav" aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li><a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
