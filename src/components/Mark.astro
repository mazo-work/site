---
// The site's mark: MAZO as the puzzle's own block letters, solved (BRIEF.md §3: MAZO resolves into the header as
// the mark). Glyphs from docs/puzzle/mazo-burr.json; the O's 16th block, the light that completes it in the finale,
// is its own path (.mark-light) so a theme can make it the accent. 64 blocks; one block is 2 × 2 user units.
import data from '../../docs/puzzle/mazo-burr.json';

interface Props { class?: string; }
const { class: cls } = Astro.props;
const design = data.designs[0];
const order = ['M', 'A', 'Z', 'O'] as const;
const cell = 2, pitch = 13;                       // letters 5 blocks wide, 1.5 blocks apart (the puzzle's title spacing)
let body = '', light = '';
order.forEach((L, k) => {
  const rows: string[] = (design.pieces as any)[L].glyph;
  rows.forEach((row, r) => [...row].forEach((ch, c) => {
    const x = k * pitch + c * cell, y = r * cell;
    if (ch === 'X') body += `M${x} ${y}h2v2h-2z`;
    else if (L === 'O' && (r === 0 || r === 4 || c === 0 || c === 4)) light += `M${x} ${y}h2v2h-2z`;
  }));
});
---
<svg class:list={['mark', cls]} viewBox="0 0 49 10" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
  <path class="mark-body" d={body} />
  <path class="mark-light" d={light} />
</svg>
