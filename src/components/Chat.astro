---
// The assistant's launcher (U12). Only the button and a few lines load with the page; the widget itself is imported
// the first time it is pressed. Shown only with JavaScript.
---
<button type="button" class="chat-launcher" aria-label="Assistant" aria-expanded="false" aria-controls="chat-panel" data-chat>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-chat]');
  button?.addEventListener('click', () => { import('../scripts/chat-widget.js').then((m) => m.toggle(button)); });
</script>
