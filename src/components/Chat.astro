---
// The Ask button (BRIEF.md §3, the skeleton, item 6): the gag assistant's launcher, bottom-right, the same size and
// place in both masks. Only the button and a few lines load with the page; the widget itself is imported the first
// time it is pressed. Shown only with JavaScript. Its name starts with what it shows ("Ask"), so voice control works.
---
<button type="button" class="chat-launcher" aria-expanded="false" aria-controls="chat-panel" data-chat>Ask<span class="vh"> the assistant</span></button>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-chat]');
  button?.addEventListener('click', () => { import('../scripts/chat-widget.js').then((m) => m.toggle(button)); });
</script>
